%% Güven Sınırları Diyagramı
%% Bu diyagram, ajantik sistemdeki farklı güvenilirlik bölgelerini ve aralarındaki sınırları gösterir.

graph TB
    subgraph "🟢 Güvenilir Bölge (Tam Kontrol)"
        direction TB
        A[Sistem Talimatları]
        B[Güvenlik Politikaları]
        C[Onaylanmış Araç Tanımları]
        D[Şifreleme Anahtarları]
    end

    subgraph "🟡 Kısmen Güvenilir Bölge (Doğrulama Gerekli)"
        direction TB
        E[Kullanıcı Girdisi]
        F[Kullanıcı Oturum Bilgileri]
        G[İç API Yanıtları]
    end

    subgraph "🔴 Güvenilmeyen Bölge (Her Zaman Temizle)"
        direction TB
        H[Dış E-posta İçeriği]
        I[Web Sayfası Verileri]
        J[Üçüncü Taraf API Yanıtları]
        K[Paylaşılan Belgeler]
        L[Kullanıcı Yüklenen Dosyalar]
    end

    subgraph "⚪ Ajan Çekirdeği"
        direction TB
        M[LLM Karar Motoru]
        N[Bağlam Yöneticisi]
        O[Bellek Katmanı]
    end

    subgraph "🔵 Çıktı Bölgesi (İzleme Gerekli)"
        direction TB
        P[E-posta Gönderme]
        Q[Takvim Yazma]
        R[Dosya Yazma]
        S[API Çağrıları]
    end

    A ==>|"Doğrudan kontrol"| M
